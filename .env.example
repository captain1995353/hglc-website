# ---------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------

# Public site URL (no trailing slash). Used for auth + payment callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- SSLCommerz (BDT: bKash, Nagad, Rocket, cards) -------------------
# Sandbox credentials: https://developer.sslcommerz.com/registration/
SSLCZ_STORE_ID=yourstore0live
SSLCZ_STORE_PASSWORD=yourstorepass
# "true" while testing, "false" in production
SSLCZ_SANDBOX=true

# --- Stripe (USD, international students) ----------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Manual / offline transfer details shown on the checkout page ----
NEXT_PUBLIC_BKASH_NUMBER=01XXXXXXXXX
NEXT_PUBLIC_NAGAD_NUMBER=01XXXXXXXXX
NEXT_PUBLIC_BANK_DETAILS=Bank name, A/C name, A/C number, branch

# --- Centre contact details (shown across the site) ------------------
NEXT_PUBLIC_CONTACT_PHONE=+880 1XXX-XXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=info@hglc.com.bd
